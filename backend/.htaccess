# Roteia todas as requisições para index.php (exceto arquivos/pastas reais).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Protege config, banco, scripts de linha de comando e dumps de schema.
# Os scripts também se defendem sozinhos (PHP_SAPI !== 'cli'), porque este
# .htaccess é ignorado quando o servidor não permite AllowOverride.
<FilesMatch "(^config\.php$|^seed\.php$|^migrar\.php$|\.db$|\.sqlite$|\.sql$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
